---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { docsItems, docsNavigation } from "../data/docs-navigation";
import BaseLayout from "./BaseLayout.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  currentPath: `/docs/${string}`;
  headings?: Heading[];
}

const { title, description, currentPath, headings = [] } = Astro.props;
const currentIndex = docsItems.findIndex((item) => item.path === currentPath);
const previous = currentIndex > 0 ? docsItems[currentIndex - 1] : undefined;
const next = currentIndex >= 0 ? docsItems[currentIndex + 1] : undefined;
const tableOfContents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout title={`${title} - Yep Anywhere Docs`} description={description}>
  <Header activePage="docs" />
  <main class="docs-shell">
    <div class="site-container docs-grid">
      <aside class="docs-sidebar" aria-label="Documentation navigation">
        <a class="docs-home-link" href="/docs">Documentation</a>
        {docsNavigation.map((section) => (
          <section class="docs-nav-section">
            <h2>{section.title}</h2>
            <ul>
              {section.items.map((item) => (
                <li>
                  <a
                    href={item.path}
                    class:list={{ active: item.path === currentPath }}
                    aria-current={item.path === currentPath ? "page" : undefined}
                  >
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </aside>

      <details class="docs-mobile-nav">
        <summary>Browse documentation</summary>
        <div class="docs-mobile-nav-panel">
          {docsNavigation.map((section) => (
            <section>
              <h2>{section.title}</h2>
              <ul>
                {section.items.map((item) => (
                  <li><a href={item.path} aria-current={item.path === currentPath ? "page" : undefined}>{item.title}</a></li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </details>

      <article class="docs-article">
        <header class="docs-heading">
          <p class="eyebrow">Yep Anywhere docs</p>
          <h1>{title}</h1>
          <p>{description}</p>
        </header>

        <div class="docs-content article-content">
          <slot />
        </div>

        <nav class="docs-pagination" aria-label="Documentation pagination">
          {previous ? (
            <a href={previous.path} rel="prev">
              <span>Previous</span>
              <strong>{previous.title}</strong>
            </a>
          ) : <span />}
          {next && (
            <a href={next.path} rel="next" class="next">
              <span>Next</span>
              <strong>{next.title}</strong>
            </a>
          )}
        </nav>
      </article>

      {tableOfContents.length > 0 && (
        <aside class="docs-toc" aria-label="On this page">
          <h2>On this page</h2>
          <ul>
            {tableOfContents.map((heading) => (
              <li class:list={{ nested: heading.depth === 3 }}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>
  </main>
  <Footer />
</BaseLayout>

<script is:inline>
document.querySelectorAll('.docs-content pre').forEach(function(pre) {
  var code = pre.querySelector('code');
  if (!code) return;
  var button = document.createElement('button');
  button.type = 'button';
  button.className = 'copy-code';
  button.textContent = 'Copy';
  button.setAttribute('aria-label', 'Copy code block');
  button.addEventListener('click', async function() {
    await navigator.clipboard.writeText(code.textContent || '');
    button.textContent = 'Copied';
    window.setTimeout(function() { button.textContent = 'Copy'; }, 1600);
  });
  pre.appendChild(button);
});
</script>

<style>
  .docs-shell {
    padding: 48px 0 72px;
  }

  .docs-grid {
    display: grid;
    grid-template-columns: 210px minmax(0, 720px) 180px;
    gap: 44px;
    align-items: start;
  }

  .docs-sidebar,
  .docs-toc {
    position: sticky;
    top: 24px;
  }

  .docs-home-link {
    color: var(--text-primary);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
  }

  .docs-nav-section {
    margin-top: 24px;
  }

  .docs-nav-section h2,
  .docs-toc h2,
  .docs-mobile-nav h2 {
    color: var(--text-secondary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .docs-nav-section ul,
  .docs-toc ul,
  .docs-mobile-nav ul {
    list-style: none;
    margin-top: 8px;
  }

  .docs-nav-section li + li,
  .docs-toc li + li {
    margin-top: 3px;
  }

  .docs-nav-section a,
  .docs-toc a {
    border-radius: 6px;
    color: var(--text-secondary);
    display: block;
    font-size: 13px;
    line-height: 1.35;
    padding: 7px 9px;
    text-decoration: none;
  }

  .docs-nav-section a:hover,
  .docs-nav-section a.active {
    background: var(--bg-secondary);
    color: var(--text-primary);
  }

  .docs-nav-section a.active {
    box-shadow: inset 2px 0 var(--accent);
  }

  .docs-heading {
    border-bottom: 1px solid var(--border);
    margin-bottom: 32px;
    padding-bottom: 28px;
  }

  .eyebrow {
    color: var(--accent);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.09em;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  .docs-heading h1 {
    font-size: clamp(32px, 5vw, 48px);
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .docs-heading > p:last-child {
    color: var(--text-secondary);
    font-size: 17px;
    margin-top: 16px;
    max-width: 640px;
  }

  .docs-content :global(h2),
  .docs-content :global(h3) {
    scroll-margin-top: 24px;
  }

  .docs-content :global(table) {
    border-collapse: collapse;
    display: block;
    font-size: 14px;
    margin: 20px 0;
    max-width: 100%;
    overflow-x: auto;
    width: max-content;
  }

  .docs-content :global(th),
  .docs-content :global(td) {
    border: 1px solid var(--border);
    padding: 10px 12px;
    text-align: left;
  }

  .docs-content :global(th) {
    background: var(--bg-secondary);
    color: var(--text-primary);
  }

  .docs-content :global(pre) {
    position: relative;
  }

  .docs-content :global(.copy-code) {
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-secondary);
    cursor: pointer;
    font: inherit;
    font-size: 12px;
    padding: 5px 9px;
    position: absolute;
    right: 10px;
    top: 10px;
  }

  .docs-content :global(.copy-code:hover) {
    color: var(--text-primary);
  }

  .docs-toc h2 {
    margin: 0 0 8px 8px;
  }

  .docs-toc a {
    font-size: 12px;
    padding-bottom: 5px;
    padding-top: 5px;
  }

  .docs-toc .nested a {
    padding-left: 18px;
  }

  .docs-pagination {
    border-top: 1px solid var(--border);
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr 1fr;
    margin-top: 48px;
    padding-top: 24px;
  }

  .docs-pagination a {
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text-primary);
    padding: 14px 16px;
    text-decoration: none;
  }

  .docs-pagination a:hover {
    border-color: var(--accent);
  }

  .docs-pagination a.next {
    text-align: right;
  }

  .docs-pagination span {
    color: var(--text-secondary);
    display: block;
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .docs-pagination strong {
    font-size: 14px;
  }

  .docs-mobile-nav {
    display: none;
  }

  @media (max-width: 1050px) {
    .docs-grid {
      grid-template-columns: 200px minmax(0, 1fr);
    }

    .docs-toc {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .docs-shell {
      padding-top: 24px;
    }

    .docs-grid {
      display: block;
    }

    .docs-sidebar {
      display: none;
    }

    .docs-mobile-nav {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 10px;
      display: block;
      margin-bottom: 28px;
    }

    .docs-mobile-nav summary {
      cursor: pointer;
      font-size: 14px;
      font-weight: 600;
      min-height: 48px;
      padding: 12px 16px;
    }

    .docs-mobile-nav-panel {
      border-top: 1px solid var(--border);
      display: grid;
      gap: 20px;
      grid-template-columns: 1fr 1fr;
      padding: 16px;
    }

    .docs-mobile-nav h2 {
      margin-bottom: 6px;
    }

    .docs-mobile-nav a {
      color: var(--text-secondary);
      display: block;
      font-size: 13px;
      padding: 4px 0;
    }

    .docs-mobile-nav a[aria-current="page"] {
      color: var(--accent);
      font-weight: 600;
    }

    .docs-heading h1 {
      font-size: 34px;
    }
  }

  @media (max-width: 460px) {
    .docs-mobile-nav-panel {
      grid-template-columns: 1fr;
    }

    .docs-pagination {
      grid-template-columns: 1fr;
    }
  }
</style>
