---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { distributions, features } from "../data/catalog";
import type { PublicDistribution } from "../data/distributions";
import type { PublicFeature } from "../data/features";
import BaseLayout from "../layouts/BaseLayout.astro";

const featuredFeatures = (features as readonly PublicFeature[]).filter((feature) => feature.featured);
const desktopDistributions = (distributions as readonly PublicDistribution[]).filter((distribution) =>
  distribution.id.startsWith("desktop-"),
);
---

<BaseLayout
  title="Yep Anywhere — Supervise coding agents from anywhere"
  description="Keep Claude Code and Codex running on your machines. Supervise sessions, approve tools, review diffs, and reconnect from any browser."
>
  <Header activePage="home" />

  <div class="announcement">
    <div class="site-container announcement-content">
      <span>Experimental</span>
      <p>Desktop apps for macOS and Windows are now on GitHub Releases.</p>
      <a href="/docs/desktop-apps">See what is ready <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <main>
    <section class="hero">
      <div class="site-container hero-copy">
        <p class="eyebrow">Your agents. Your machines. Any screen.</p>
        <h1>Walk away.<br><span>Your agents keep shipping.</span></h1>
        <p class="lede">Yep Anywhere gives Claude Code and Codex a durable, mobile-ready control surface. Start at your desk, supervise from your phone, and return without losing the thread.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/docs/getting-started">Get started</a>
          <a class="btn btn-secondary" href="/features">Explore features</a>
          <a class="text-link" href="/remote">Log in to your server <span aria-hidden="true">→</span></a>
        </div>
        <p class="hero-note">Open source · self-hosted · no account required</p>
      </div>

      <div class="site-container product-stage" aria-label="Yep Anywhere on desktop and mobile">
        <figure class="desktop-frame">
          <div class="window-bar" aria-hidden="true"><i></i><i></i><i></i><span>localhost:3400</span></div>
          <img src="/screenshots/desktop.png" alt="Yep Anywhere showing several coding agent sessions on desktop">
        </figure>
        <figure class="phone-frame phone-primary">
          <span class="phone-speaker" aria-hidden="true"></span>
          <img src="/screenshots/mobile-approve-edit.png" alt="Approving a coding agent file edit from a phone">
        </figure>
        <figure class="phone-frame phone-secondary">
          <span class="phone-speaker" aria-hidden="true"></span>
          <img src="/screenshots/mobile-completed-session.png" alt="Reviewing a completed coding session from a phone">
        </figure>
      </div>
    </section>

    <section class="proof-strip" aria-label="Product highlights">
      <div class="site-container">
        <p><strong>Sessions persist</strong><span>Close the tab, not the work</span></p>
        <p><strong>Two first-class agents</strong><span>Claude Code + Codex</span></p>
        <p><strong>Remote by choice</strong><span>Direct or encrypted relay</span></p>
        <p><strong>MIT licensed</strong><span>Inspect and self-host it</span></p>
      </div>
    </section>

    <section class="promise-section">
      <div class="site-container">
        <header class="section-heading centered">
          <p class="eyebrow">A calmer way to run agents</p>
          <h2>Stay available without staying at your desk.</h2>
          <p>The server owns the work. Every browser becomes a window into it.</p>
        </header>

        <div class="promise-grid">
          <article>
            <span class="step">01</span>
            <h3>Start where the code lives</h3>
            <p>Launch sessions on your workstation, dev server, or SSH host. Yep Anywhere discovers existing compatible sessions too.</p>
          </article>
          <article>
            <span class="step">02</span>
            <h3>Leave without interrupting</h3>
            <p>Agent processes keep running when a client disconnects. Reconnect from another browser with the conversation intact.</p>
          </article>
          <article>
            <span class="step">03</span>
            <h3>Return only when needed</h3>
            <p>Use notifications and the attention inbox to find approvals, questions, and completed work instead of polling every session.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="catalog-preview">
      <div class="site-container">
        <header class="section-heading split">
          <div>
            <p class="eyebrow">Built for real agent workflows</p>
            <h2>More than a remote terminal.</h2>
          </div>
          <p>Coordinate sessions, steer active work, inspect changes, and control how each machine is exposed.</p>
        </header>

        <div class="feature-grid">
          {featuredFeatures.map((feature, index) => (
            <article class:list={["feature-card", { spotlight: index === 0 }]}>
              <span class="feature-number">{String(index + 1).padStart(2, "0")}</span>
              <h3>{feature.title}</h3>
              <p>{feature.summary}</p>
              <a href={feature.docsPath}>Read the guide <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>

        <p class="catalog-link"><a class="btn btn-secondary" href="/features">See the complete feature catalog</a></p>
      </div>
    </section>

    <section class="workflow-section">
      <div class="site-container workflow-grid">
        <div class="workflow-copy">
          <p class="eyebrow">Remote without surrendering control</p>
          <h2>Your machine stays the source of truth.</h2>
          <p>Use a local network, your own HTTPS setup, an SSH tunnel, or the free end-to-end encrypted public relay. Your provider credentials and session history remain on the host.</p>
          <ul>
            <li><strong>No hosted product account.</strong> Authenticate to the server you control.</li>
            <li><strong>No provider proxy.</strong> Agents run against your locally configured CLIs.</li>
            <li><strong>No lock-in.</strong> The app and relay are open source under MIT.</li>
          </ul>
          <a class="text-link" href="/docs/remote-access">Compare connection options <span aria-hidden="true">→</span></a>
        </div>
        <figure class="workflow-shot">
          <img src="/screenshots/desktop-remote-access.png" alt="Remote access settings in Yep Anywhere">
          <figcaption>Choose the access model that fits each host.</figcaption>
        </figure>
      </div>
    </section>

    <section class="install-section">
      <div class="site-container">
        <header class="section-heading centered">
          <p class="eyebrow">Choose your starting point</p>
          <h2>Install it where your agents run.</h2>
          <p>Desktop packaging is nearing release readiness. The npm install remains the established path for full configuration access.</p>
        </header>

        <div class="install-grid">
          <article class="install-card desktop-card">
            <div class="install-label"><span>Desktop apps</span><em>Experimental</em></div>
            <h3>macOS and Windows</h3>
            <p>Signed installers bundle the server and web client for a guided local setup.</p>
            <div class="platform-list">
              {desktopDistributions.map((distribution) => (
                <a href={distribution.downloadUrl}>{distribution.name.replace("Desktop for ", "")} <span aria-hidden="true">↗</span></a>
              ))}
            </div>
            <a class="text-link" href="/docs/desktop-apps">Desktop installation guide <span aria-hidden="true">→</span></a>
          </article>

          <article class="install-card terminal-card">
            <div class="install-label"><span>Command line</span><em class="stable">Available</em></div>
            <h3>npm on macOS, Windows, and Linux</h3>
            <div class="command-block" aria-label="Installation commands">
              <code><span>$</span> npm i -g yepanywhere</code>
              <code><span>$</span> yepanywhere</code>
            </div>
            <a class="text-link" href="/docs/install-npm">npm installation guide <span aria-hidden="true">→</span></a>
          </article>
        </div>

        <p class="mobile-status"><strong>On your phone:</strong> use the responsive browser client today. The Android app is in development and is not published.</p>
      </div>
    </section>

    <section class="faq-section">
      <div class="site-container faq-grid">
        <header>
          <p class="eyebrow">The short version</p>
          <h2>Questions before you install?</h2>
          <a href="/docs">Browse all documentation <span aria-hidden="true">→</span></a>
        </header>
        <div class="questions">
          <details open>
            <summary>Which coding agents work?</summary>
            <p>Claude Code and Codex are first-class providers. OpenCode, Grok Build, Claude + Ollama, and Gemini integrations are experimental.</p>
          </details>
          <details>
            <summary>Does the browser have to stay open?</summary>
            <p>No. The server owns agent processes, so active work continues across browser disconnects. The host machine does need to stay running.</p>
          </details>
          <details>
            <summary>Is there a hosted version?</summary>
            <p>No hosted Yep Anywhere workspace or product account is required. Run the server yourself, then connect directly or through the optional relay.</p>
          </details>
          <details>
            <summary>Is there a mobile app?</summary>
            <p>The published phone experience is the mobile browser client. An Android app is under active development but is not published.</p>
          </details>
        </div>
      </div>
    </section>

    <section class="final-cta">
      <div class="site-container cta-panel">
        <div>
          <p class="eyebrow">One install. Every screen.</p>
          <h2>Give your agents room to run.</h2>
          <p>Start locally in minutes, then decide how—and where—you want to reconnect.</p>
        </div>
        <div class="cta-actions">
          <a class="btn btn-primary" href="/docs/getting-started">Get started</a>
          <a class="btn btn-secondary" href="https://github.com/kzahel/yepanywhere">View on GitHub</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .announcement {
    background: color-mix(in srgb, var(--accent) 12%, var(--bg-primary));
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 32%, var(--border));
  }

  .announcement-content {
    align-items: center;
    display: flex;
    font-size: 13px;
    gap: 12px;
    justify-content: center;
    min-height: 42px;
  }

  .announcement-content > span {
    background: var(--accent);
    border-radius: 999px;
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 3px 8px;
    text-transform: uppercase;
  }

  .announcement-content a,
  .text-link,
  .faq-grid header a {
    color: var(--accent-hover);
    font-weight: 650;
    text-decoration: none;
  }

  .hero {
    overflow: hidden;
    padding: 94px 0 110px;
  }

  .hero-copy {
    text-align: center;
  }

  .eyebrow {
    color: var(--accent);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero h1 {
    font-size: clamp(54px, 8.5vw, 102px);
    letter-spacing: -0.065em;
    line-height: 0.9;
    margin: 24px auto 0;
    max-width: 1050px;
  }

  .hero h1 span {
    color: var(--text-secondary);
  }

  .lede {
    color: var(--text-secondary);
    font-size: clamp(18px, 2.2vw, 22px);
    line-height: 1.55;
    margin: 30px auto 0;
    max-width: 780px;
  }

  .hero-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 13px;
    justify-content: center;
    margin-top: 34px;
  }

  .hero-actions .text-link {
    margin-left: 8px;
  }

  .hero-note {
    color: var(--text-secondary);
    font-size: 12px;
    letter-spacing: 0.025em;
    margin-top: 20px;
  }

  .product-stage {
    margin-top: 72px;
    min-height: 550px;
    position: relative;
  }

  .desktop-frame {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 15px;
    box-shadow: 0 35px 100px #0008;
    margin: 0 auto;
    max-width: 1010px;
    overflow: hidden;
  }

  .window-bar {
    align-items: center;
    background: var(--bg-tertiary);
    border-bottom: 1px solid var(--border);
    display: flex;
    gap: 7px;
    height: 38px;
    padding: 0 14px;
  }

  .window-bar i {
    background: var(--text-secondary);
    border-radius: 50%;
    height: 8px;
    opacity: 0.45;
    width: 8px;
  }

  .window-bar span {
    color: var(--text-secondary);
    font-family: monospace;
    font-size: 10px;
    margin-left: auto;
    margin-right: auto;
  }

  .desktop-frame img,
  .phone-frame img,
  .workflow-shot img {
    display: block;
    height: auto;
    width: 100%;
  }

  .phone-frame {
    background: #080808;
    border: 5px solid #0a0a0a;
    border-radius: 28px;
    box-shadow: 0 25px 70px #000a;
    overflow: hidden;
    position: absolute;
    width: min(225px, 21vw);
  }

  .phone-primary {
    bottom: -18px;
    left: 0;
    transform: rotate(-3deg);
  }

  .phone-secondary {
    bottom: -46px;
    right: 0;
    transform: rotate(3deg);
  }

  .phone-speaker {
    background: #272727;
    border-radius: 99px;
    height: 5px;
    left: 41%;
    position: absolute;
    top: 8px;
    width: 18%;
    z-index: 2;
  }

  .proof-strip {
    border-bottom: 1px solid var(--border);
    border-top: 1px solid var(--border);
  }

  .proof-strip .site-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .proof-strip p {
    display: flex;
    flex-direction: column;
    padding: 28px 24px;
  }

  .proof-strip p + p {
    border-left: 1px solid var(--border);
  }

  .proof-strip strong {
    font-size: 14px;
  }

  .proof-strip span {
    color: var(--text-secondary);
    font-size: 12px;
  }

  .promise-section,
  .catalog-preview,
  .workflow-section,
  .install-section,
  .faq-section,
  .final-cta {
    padding: 112px 0;
  }

  .catalog-preview,
  .install-section {
    background: var(--bg-secondary);
  }

  .section-heading h2,
  .workflow-copy h2,
  .faq-grid h2,
  .cta-panel h2 {
    font-size: clamp(36px, 5vw, 58px);
    letter-spacing: -0.045em;
    line-height: 1.03;
    margin-top: 13px;
  }

  .section-heading > p,
  .split > p,
  .workflow-copy > p,
  .cta-panel > div > p:last-child {
    color: var(--text-secondary);
    font-size: 17px;
  }

  .section-heading.centered {
    margin: 0 auto 52px;
    max-width: 820px;
    text-align: center;
  }

  .section-heading.centered > p:last-child {
    margin: 20px auto 0;
    max-width: 670px;
  }

  .section-heading.split {
    align-items: end;
    display: grid;
    gap: 60px;
    grid-template-columns: 1.3fr 0.7fr;
    margin-bottom: 52px;
  }

  .promise-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(3, 1fr);
  }

  .promise-grid article {
    border: 1px solid var(--border);
    border-radius: 14px;
    min-height: 270px;
    padding: 28px;
  }

  .step,
  .feature-number {
    color: var(--accent);
    font-family: monospace;
    font-size: 12px;
  }

  .promise-grid h3,
  .feature-card h3,
  .install-card h3 {
    font-size: 21px;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-top: 46px;
  }

  .promise-grid p,
  .feature-card p,
  .install-card > p {
    color: var(--text-secondary);
    font-size: 14px;
    margin-top: 13px;
  }

  .feature-grid {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(3, 1fr);
    overflow: hidden;
  }

  .feature-card {
    background: var(--bg-primary);
    min-height: 286px;
    padding: 30px;
    position: relative;
  }

  .feature-card.spotlight {
    grid-column: span 2;
  }

  .feature-card h3 {
    margin-top: 34px;
  }

  .feature-card a {
    bottom: 28px;
    color: var(--text-primary);
    font-size: 13px;
    font-weight: 650;
    position: absolute;
    text-decoration: none;
  }

  .catalog-link {
    margin-top: 30px;
    text-align: center;
  }

  .workflow-grid {
    align-items: center;
    display: grid;
    gap: 70px;
    grid-template-columns: 0.82fr 1.18fr;
  }

  .workflow-copy > p {
    margin-top: 22px;
  }

  .workflow-copy ul {
    display: grid;
    gap: 16px;
    list-style: none;
    margin: 30px 0;
  }

  .workflow-copy li {
    color: var(--text-secondary);
    font-size: 14px;
    padding-left: 22px;
    position: relative;
  }

  .workflow-copy li::before {
    color: var(--accent);
    content: "✓";
    left: 0;
    position: absolute;
  }

  .workflow-copy strong {
    color: var(--text-primary);
  }

  .workflow-shot {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 25px 70px #0007;
    overflow: hidden;
  }

  .workflow-shot figcaption {
    color: var(--text-secondary);
    font-size: 12px;
    padding: 12px 16px;
  }

  .install-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: 1fr 1fr;
  }

  .install-card {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    min-height: 375px;
    padding: 30px;
  }

  .install-label {
    align-items: center;
    display: flex;
    justify-content: space-between;
  }

  .install-label > span {
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .install-label em {
    background: #d977061c;
    border: 1px solid #d9770655;
    border-radius: 99px;
    color: #f59e0b;
    font-size: 10px;
    font-style: normal;
    padding: 3px 8px;
  }

  .install-label em.stable {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border-color: color-mix(in srgb, var(--accent) 42%, transparent);
    color: var(--accent-hover);
  }

  .install-card h3 {
    font-size: 25px;
    margin-top: 48px;
  }

  .install-card .text-link {
    margin-top: auto;
  }

  .platform-list {
    display: flex;
    gap: 10px;
    margin: 28px 0;
  }

  .platform-list a {
    border: 1px solid var(--border);
    border-radius: 7px;
    color: var(--text-primary);
    font-size: 13px;
    padding: 9px 12px;
    text-decoration: none;
  }

  .command-block {
    background: #080808;
    border: 1px solid #292929;
    border-radius: 9px;
    display: grid;
    gap: 8px;
    margin: 26px 0;
    padding: 18px;
  }

  .command-block code {
    color: #e5e5e5;
    font-size: 13px;
  }

  .command-block span {
    color: #22c55e;
  }

  .mobile-status {
    color: var(--text-secondary);
    font-size: 13px;
    margin-top: 24px;
    text-align: center;
  }

  .mobile-status strong {
    color: var(--text-primary);
  }

  .faq-grid {
    display: grid;
    gap: 90px;
    grid-template-columns: 0.72fr 1.28fr;
  }

  .faq-grid header a {
    display: inline-block;
    margin-top: 25px;
  }

  .questions details {
    border-top: 1px solid var(--border);
    padding: 24px 0;
  }

  .questions details:last-child {
    border-bottom: 1px solid var(--border);
  }

  .questions summary {
    cursor: pointer;
    font-size: 17px;
    font-weight: 650;
  }

  .questions p {
    color: var(--text-secondary);
    font-size: 14px;
    margin-top: 13px;
    max-width: 650px;
  }

  .final-cta {
    padding-top: 0;
  }

  .cta-panel {
    align-items: end;
    background: color-mix(in srgb, var(--accent) 12%, var(--bg-secondary));
    border: 1px solid color-mix(in srgb, var(--accent) 34%, var(--border));
    border-radius: 18px;
    display: flex;
    gap: 40px;
    justify-content: space-between;
    padding: 52px;
  }

  .cta-panel > div:first-child {
    max-width: 690px;
  }

  .cta-panel > div > p:last-child {
    margin-top: 17px;
  }

  .cta-actions {
    display: flex;
    flex-shrink: 0;
    gap: 10px;
  }

  @media (max-width: 800px) {
    .announcement-content {
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 5px 8px;
      justify-content: flex-start;
      padding-bottom: 10px;
      padding-top: 10px;
    }

    .announcement-content p {
      width: calc(100% - 86px);
    }

    .announcement-content a {
      margin-left: 84px;
    }

    .hero {
      padding: 70px 0 74px;
    }

    .hero h1 {
      font-size: clamp(49px, 15vw, 70px);
    }

    .hero-actions .text-link {
      margin: 8px 0 0;
      width: 100%;
    }

    .product-stage {
      margin-top: 50px;
      min-height: 390px;
      padding-left: 16px;
      padding-right: 16px;
    }

    .desktop-frame {
      width: 720px;
    }

    .phone-frame {
      border-radius: 22px;
      width: 145px;
    }

    .phone-primary {
      bottom: -12px;
      left: 25px;
    }

    .phone-secondary {
      bottom: -25px;
      right: 22px;
    }

    .proof-strip .site-container {
      grid-template-columns: 1fr 1fr;
      padding: 0;
    }

    .proof-strip p {
      padding: 20px;
    }

    .proof-strip p + p {
      border-left: 0;
    }

    .proof-strip p:nth-child(even) {
      border-left: 1px solid var(--border);
    }

    .proof-strip p:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }

    .promise-section,
    .catalog-preview,
    .workflow-section,
    .install-section,
    .faq-section,
    .final-cta {
      padding: 78px 0;
    }

    .section-heading.split,
    .workflow-grid,
    .faq-grid {
      gap: 32px;
      grid-template-columns: 1fr;
    }

    .promise-grid,
    .feature-grid,
    .install-grid {
      grid-template-columns: 1fr;
    }

    .promise-grid article {
      min-height: 225px;
    }

    .feature-card.spotlight {
      grid-column: auto;
    }

    .feature-card {
      min-height: 260px;
    }

    .workflow-shot {
      order: -1;
    }

    .install-card {
      min-height: 350px;
    }

    .faq-grid {
      gap: 42px;
    }

    .cta-panel {
      align-items: flex-start;
      flex-direction: column;
      padding: 35px 26px;
    }

    .cta-actions {
      flex-direction: column;
