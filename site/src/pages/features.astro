---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import {
  distributions,
  featureCategories,
  features,
  providers,
} from "../data/catalog";
import type { PublicDistribution } from "../data/distributions";
import type { PublicFeature } from "../data/features";
import BaseLayout from "../layouts/BaseLayout.astro";

const publicFeatures = features as readonly PublicFeature[];
const publicDistributions = distributions as readonly PublicDistribution[];
const providerNames = new Map(providers.map((provider) => [provider.id, provider.name]));
---

<BaseLayout
  title="Features - Yep Anywhere"
  description="Explore Yep Anywhere's mobile supervision, multi-agent coordination, provider integrations, review tools, and secure remote access."
>
  <Header activePage="features" />

  <main>
    <section class="features-hero">
      <div class="site-container">
        <p class="eyebrow">Product catalog</p>
        <h1>Your agents, wherever you are.</h1>
        <p class="lede">Yep Anywhere keeps coding agents running on your machines and gives you one place to supervise, coordinate, review, and reconnect.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/docs/getting-started">Get started</a>
          <a class="btn btn-secondary" href="/docs/providers">Compare providers</a>
        </div>
        <div class="catalog-summary" aria-label="Feature catalog summary">
          <span><strong>{publicFeatures.length}</strong> shipped capabilities</span>
          <span><strong>{providers.filter((provider) => provider.status === "stable").length}</strong> first-class providers</span>
          <span><strong>3</strong> ways to connect</span>
        </div>
      </div>
    </section>

    <nav class="category-nav" aria-label="Feature categories">
      <div class="site-container">
        {featureCategories.map((category) => (
          <a href={`#${category.id}`}>{category.title}</a>
        ))}
      </div>
    </nav>

    {featureCategories.map((category, categoryIndex) => {
      const categoryFeatures = publicFeatures.filter((feature) => feature.category === category.id);
      const illustratedFeature = categoryFeatures.find((feature) => feature.image);
      return (
        <section class:list={["feature-section", { alternate: categoryIndex % 2 === 1 }]} id={category.id}>
          <div class="site-container">
            <header class="section-heading">
              <div>
                <p class="eyebrow">{category.eyebrow}</p>
                <h2>{category.title}</h2>
              </div>
              <p>{category.description}</p>
            </header>

            {illustratedFeature && (
              <figure class="section-proof">
                <img src={illustratedFeature.image?.src} alt={illustratedFeature.image?.alt} loading="lazy">
                <figcaption>{illustratedFeature.title}</figcaption>
              </figure>
            )}

            <div class="feature-grid">
              {categoryFeatures.map((feature) => (
                <article class="feature-card">
                  <div class="card-heading">
                    <h3>{feature.title}</h3>
                    {feature.status === "experimental" && <span class="status experimental">Experimental</span>}
                  </div>
                  <p>{feature.summary}</p>
                  {feature.providers && (
                    <p class="availability"><strong>Providers:</strong> {feature.providers.map((id) => providerNames.get(id)).join(", ")}</p>
                  )}
                  {feature.availability && <p class="availability">{feature.availability}</p>}
                  <a class="learn-link" href={feature.docsPath}>Read the guide <span aria-hidden="true">→</span></a>
                </article>
              ))}
            </div>
          </div>
        </section>
      );
    })}

    <section class="providers-section">
      <div class="site-container">
        <header class="section-heading">
          <div>
            <p class="eyebrow">Provider support</p>
            <h2>Parity where it matters. Honesty where it varies.</h2>
          </div>
          <p>Claude Code and Codex are first-class. Experimental integrations show their narrower edges instead of borrowing a blanket support claim.</p>
        </header>
        <div class="provider-grid">
          {providers.map((provider) => (
            <article>
              <div class="card-heading">
                <h3>{provider.name}</h3>
                <span class:list={["status", provider.status]}>{provider.status === "stable" ? "Stable" : "Experimental"}</span>
              </div>
              <p>{provider.summary}</p>
              <small>{provider.notes}</small>
            </article>
          ))}
        </div>
        <p class="section-link"><a href="/docs/providers">Provider setup and capability notes →</a></p>
      </div>
    </section>

    <section class="install-section">
      <div class="site-container">
        <header class="section-heading">
          <div>
            <p class="eyebrow">Install and access</p>
            <h2>Choose the surface that fits your host.</h2>
          </div>
          <p>Desktop installers are available now but remain experimental. The mobile browser is the published phone experience while the Android app is in development.</p>
        </header>
        <div class="distribution-grid">
          {publicDistributions.map((distribution) => (
            <article class:list={{ development: distribution.status === "development" }}>
              <div class="card-heading">
                <h3>{distribution.name}</h3>
                <span class:list={["status", distribution.status]}>
                  {distribution.status === "available" ? "Available" : distribution.status === "experimental" ? "Experimental" : "In development"}
                </span>
              </div>
              <p class="platform">{distribution.platform}</p>
              <p>{distribution.summary}</p>
              <div class="distribution-actions">
                <a href={distribution.docsPath}>Setup guide</a>
                {distribution.downloadUrl && <a href={distribution.downloadUrl}>{distribution.actionLabel}</a>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="final-cta">
      <div class="site-container cta-panel">
        <div>
          <p class="eyebrow">Ready when you are</p>
          <h2>Keep the machine. Lose the desk.</h2>
          <p>Start locally, then connect from any browser when you are ready to walk away.</p>
        </div>
        <a class="btn btn-primary" href="/docs/getting-started">Get started</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .features-hero {
    padding: 92px 0 70px;
  }

  .eyebrow {
    color: var(--accent);
    font-size: 12px;
    font-weight: 750;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .features-hero h1 {
    font-size: clamp(44px, 8vw, 76px);
    letter-spacing: -0.055em;
    line-height: 0.96;
    margin-top: 14px;
    max-width: 940px;
  }

  .lede {
    color: var(--text-secondary);
    font-size: 20px;
    margin-top: 24px;
    max-width: 760px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .catalog-summary {
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
    display: flex;
    flex-wrap: wrap;
    gap: 14px 34px;
    margin-top: 54px;
    padding-top: 24px;
  }

  .catalog-summary strong {
    color: var(--text-primary);
    font-size: 20px;
    margin-right: 5px;
  }

  .category-nav {
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
    border-top: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .category-nav .site-container {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .category-nav a {
    color: var(--text-secondary);
    flex: none;
    font-size: 12px;
    font-weight: 600;
    padding: 13px 0;
    text-decoration: none;
  }

  .category-nav a:hover {
    color: var(--text-primary);
  }

  .feature-section,
  .providers-section,
  .install-section {
    border-bottom: 1px solid var(--border);
    padding: 78px 0;
    scroll-margin-top: 44px;
  }

  .feature-section.alternate,
  .install-section {
    background: var(--bg-secondary);
  }

  .section-heading {
    align-items: end;
    display: grid;
    gap: 32px;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    margin-bottom: 34px;
  }

  .section-heading h2 {
    font-size: clamp(30px, 4.5vw, 46px);
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-top: 10px;
    max-width: 680px;
  }

  .section-heading > p {
    color: var(--text-secondary);
    font-size: 16px;
  }

  .section-proof {
    float: right;
    margin: 0 0 24px 34px;
    max-width: 190px;
    text-align: center;
  }

  .section-proof img {
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.28);
    display: block;
    width: 100%;
  }

  .section-proof figcaption {
    color: var(--text-secondary);
    font-size: 11px;
    margin-top: 8px;
  }

  .feature-grid,
  .provider-grid,
  .distribution-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .feature-card,
  .provider-grid article,
  .distribution-grid article {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    min-height: 210px;
    padding: 22px;
  }

  .alternate .feature-card,
  .distribution-grid article {
    background: color-mix(in srgb, var(--bg-primary) 88%, var(--bg-secondary));
  }

  .card-heading {
    align-items: flex-start;
    display: flex;
    gap: 10px;
    justify-content: space-between;
  }

  .card-heading h3 {
    font-size: 17px;
    line-height: 1.25;
  }

  .status {
    border: 1px solid var(--border);
    border-radius: 99px;
    color: var(--text-secondary);
    flex: none;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 3px 7px;
    text-transform: uppercase;
  }

  .status.stable,
  .status.available {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    color: var(--accent-hover);
  }

  .status.experimental {
    border-color: #8d6d27;
    color: #d9ac4a;
  }

  .status.development {
    color: var(--text-secondary);
  }

  .feature-card > p,
  .provider-grid article > p,
  .distribution-grid article > p {
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.6;
    margin-top: 13px;
  }

  .feature-card .availability {
    font-size: 11px;
    margin-top: 12px;
  }

  .availability strong {
    color: var(--text-primary);
  }

  .learn-link {
    color: var(--accent);
    font-size: 13px;
    font-weight: 650;
    margin-top: auto;
    padding-top: 18px;
    text-decoration: none;
  }

  .provider-grid article small {
    color: var(--text-secondary);
    display: block;
    font-size: 11px;
    line-height: 1.5;
    margin-top: auto;
    padding-top: 14px;
  }

  .section-link {
    margin-top: 24px;
    text-align: right;
  }

  .section-link a {
    color: var(--accent);
    font-size: 14px;
    font-weight: 650;
    text-decoration: none;
  }

  .distribution-grid {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .distribution-grid article {
    min-height: 260px;
  }

  .distribution-grid article.development {
    border-style: dashed;
  }

  .distribution-grid .platform {
    color: var(--text-primary);
    font-size: 11px;
    font-weight: 650;
  }

  .distribution-actions {
    display: grid;
    gap: 6px;
    margin-top: auto;
    padding-top: 16px;
  }

  .distribution-actions a {
    color: var(--accent);
    font-size: 12px;
    font-weight: 650;
  }

  .final-cta {
    padding: 76px 0;
  }

  .cta-panel {
    align-items: center;
    background: linear-gradient(135deg, var(--bg-secondary), var(--bg-tertiary));
    border: 1px solid var(--border);
    border-radius: 18px;
    display: flex;
    justify-content: space-between;
    padding: 38px 42px;
  }

  .cta-panel h2 {
    font-size: 32px;
    letter-spacing: -0.035em;
    margin-top: 6px;
  }

  .cta-panel p:last-child {
    color: var(--text-secondary);
    margin-top: 8px;
  }

  @media (max-width: 980px) {
    .feature-grid,
    .provider-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .distribution-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .features-hero {
      padding: 62px 0 54px;
    }

    .features-hero h1 {
      font-size: 48px;
    }

    .category-nav {
      position: relative;
    }

    .section-heading {
      align-items: start;
      grid-template-columns: 1fr;
    }

    .section-proof {
      float: none;
      margin: 0 auto 26px;
      max-width: 220px;
    }

    .feature-grid,
    .provider-grid,
    .distribution-grid {
      grid-template-columns: 1fr;
    }

    .feature-card,
    .provider-grid article,
    .distribution-grid article {
      min-height: auto;
    }

    .cta-panel {
      align-items: flex-start;
      flex-direction: column;
      gap: 24px;
      padding: 30px 26px;
    }
  }
</style>
