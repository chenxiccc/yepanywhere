---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

interface DocsEntry {
  id: string;
  data: {
    title: string;
    description: string;
  };
}

export async function getStaticPaths() {
  const entries = (await getCollection("docs")) as unknown as DocsEntry[];
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: DocsEntry };
const { Content, headings } = await render(entry as never);
const currentPath = `/docs/${entry.id}` as `/docs/${string}`;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  currentPath={currentPath}
  headings={headings}
>
  <Content />
</DocsLayout>
