---
interface Props {
  activePage?: "home" | "features" | "docs" | "news" | "privacy";
}

const { activePage } = Astro.props;
const links = [
  { href: "/features", label: "Features", key: "features" },
  { href: "/docs", label: "Docs", key: "docs" },
  { href: "/news", label: "News", key: "news" },
  { href: "https://github.com/kzahel/yepanywhere", label: "GitHub", key: "github" },
] as const;
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <div class="site-container header-content">
    <a href="/" class="logo" aria-label="Yep Anywhere home">
      <img src="/branding/lockup-dark.svg" alt="Yep Anywhere">
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {links.map((link) => (
        <a href={link.href} class:list={{ active: activePage === link.key }} aria-current={activePage === link.key ? "page" : undefined}>
          {link.label}
        </a>
      ))}
      <a href="/remote" class="login-link">Log In</a>
      <a href="/docs/getting-started" class="header-cta">Get started</a>
      <button class="theme-toggle" aria-label="Toggle color theme" type="button">
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
    </nav>

    <div class="mobile-actions">
      <a href="/docs/getting-started" class="mobile-cta">Get started</a>
      <details class="mobile-menu">
        <summary aria-label="Open navigation menu"><span>Menu</span></summary>
        <nav aria-label="Mobile navigation">
          {links.map((link) => (
            <a href={link.href} aria-current={activePage === link.key ? "page" : undefined}>{link.label}</a>
          ))}
          <a href="/remote">Log In to your server</a>
          <button class="theme-toggle" aria-label="Toggle color theme" type="button">Toggle theme</button>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: color-mix(in srgb, var(--bg-primary) 92%, transparent);
    border-bottom: 1px solid var(--border);
    position: relative;
    z-index: 20;
  }

  .header-content {
    align-items: center;
    display: flex;
    justify-content: space-between;
    min-height: 72px;
  }

  .logo {
    display: flex;
  }

  .logo img {
    height: 34px;
    width: auto;
  }

  .desktop-nav {
    align-items: center;
    display: flex;
    gap: 6px;
  }

  .desktop-nav a {
    border-radius: 7px;
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 500;
    padding: 8px 10px;
    text-decoration: none;
  }

  .desktop-nav a:hover,
  .desktop-nav a.active {
    background: var(--bg-secondary);
    color: var(--text-primary);
  }

  .desktop-nav .login-link {
    color: var(--accent);
    margin-left: 4px;
  }

  .desktop-nav .header-cta,
  .mobile-cta {
    background: var(--accent);
    color: white;
    font-weight: 650;
  }

  .desktop-nav .header-cta:hover,
  .mobile-cta:hover {
    background: var(--accent-hover);
    color: white;
  }

  .theme-toggle {
    align-items: center;
    background: none;
    border: 1px solid var(--border);
    border-radius: 7px;
    color: var(--text-secondary);
    cursor: pointer;
    display: flex;
    justify-content: center;
    min-height: 36px;
    min-width: 36px;
  }

  .theme-toggle:hover {
    border-color: var(--text-secondary);
    color: var(--text-primary);
  }

  .icon-moon { display: none; }
  .icon-sun { display: block; }
  :global(html[data-theme="light"]) .icon-sun { display: none; }
  :global(html[data-theme="light"]) .icon-moon { display: block; }

  .mobile-actions {
    align-items: center;
    display: none;
    gap: 8px;
  }

  .mobile-cta {
    border-radius: 7px;
    font-size: 12px;
    padding: 8px 10px;
    text-decoration: none;
  }

  .mobile-menu {
    position: relative;
  }

  .mobile-menu summary {
    align-items: center;
    border: 1px solid var(--border);
    border-radius: 7px;
    cursor: pointer;
    display: flex;
    font-size: 12px;
    font-weight: 600;
    min-height: 36px;
    padding: 7px 10px;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu nav {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.3);
    display: grid;
    min-width: 220px;
    padding: 8px;
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
  }

  .mobile-menu nav a,
  .mobile-menu nav button {
    background: none;
    border: 0;
    border-radius: 7px;
    color: var(--text-primary);
    display: block;
    font: inherit;
    font-size: 14px;
    min-height: 44px;
    padding: 11px 12px;
    text-align: left;
    text-decoration: none;
    width: 100%;
  }

  .mobile-menu nav a:hover,
  .mobile-menu nav a[aria-current="page"],
  .mobile-menu nav button:hover {
    background: var(--bg-secondary);
  }

  @media (max-width: 760px) {
    .header-content {
      min-height: 64px;
    }

    .logo img {
      height: 30px;
    }

    .desktop-nav {
      display: none;
    }

    .mobile-actions {
      display: flex;
    }
  }
</style>

<script is:inline>
(function() {
  function applyTheme(next) {
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    document.querySelectorAll('.logo img').forEach(function(logo) {
      logo.src = next === 'light' ? '/branding/lockup-light.svg' : '/branding/lockup-dark.svg';
    });
  }
  document.querySelectorAll('.theme-toggle').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var current = document.documentElement.getAttribute('data-theme');
      applyTheme(current === 'light' ? 'dark' : 'light');
    });
  });
  var theme = document.documentElement.getAttribute('data-theme');
  if (theme === 'light') applyTheme('light');
})();
</script>
